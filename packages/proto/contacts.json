{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Contacts",
  "description": "Contacts synchronization (capability contacts). All operations ride POST /contacts or persistent WebSocket with envelope gating protocol_v->min_peer_build->capability->token->payload. Contacts listing is cursor-paged with search query support; avatars are fetched on demand or embedded up to 64KB base64. Decoders ignore unknown fields.",
  "type": "object",
  "additionalProperties": true,
  "required": ["protocol_v", "type", "sender", "capabilities", "payload"],
  "properties": {
    "protocol_v": { "type": "integer", "minimum": 1 },
    "type": {
      "type": "string",
      "enum": ["contacts-list-req", "contacts-list-resp", "contact-avatar-req", "contact-avatar-resp", "contacts-changed"]
    },
    "sender": {
      "type": "object",
      "additionalProperties": true,
      "required": ["platform", "app_build", "min_peer_build"],
      "properties": {
        "platform": { "type": "string" },
        "app_build": { "type": "integer", "minimum": 0 },
        "min_peer_build": { "type": "integer", "minimum": 0 },
        "app_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$",
          "description": "Human app version, e.g. 0.13.0. Display-only."
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string" }
    },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "required": ["nonce"],
      "properties": {
        "nonce": {
          "type": "string",
          "minLength": 1,
          "description": "Random per-message value the ack or response echoes."
        },
        "req_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Correlation ID for req/resp pairs."
        },
        "cursor": {
          "type": "string",
          "maxLength": 256,
          "description": "Paging cursor (empty = first page)."
        },
        "next_cursor": {
          "type": "string",
          "maxLength": 256,
          "description": "Next page cursor (empty = last page)."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "Page limit (1..100, default 50)."
        },
        "query": {
          "type": "string",
          "maxLength": 128,
          "description": "Optional search term to filter contacts by name or phone."
        },
        "contact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Opaque phone contact ID."
        },
        "entries": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["contact_id", "display_name"],
            "properties": {
              "contact_id": { "type": "string", "minLength": 1, "maxLength": 64 },
              "display_name": { "type": "string", "maxLength": 128 },
              "phones": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "type": "object",
                  "additionalProperties": true,
                  "required": ["number"],
                  "properties": {
                    "number": { "type": "string", "maxLength": 32 },
                    "type": { "type": "string", "maxLength": 32 },
                    "label": { "type": "string", "maxLength": 32 },
                    "is_primary": { "type": "boolean" }
                  }
                }
              },
              "emails": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "type": "object",
                  "additionalProperties": true,
                  "required": ["address"],
                  "properties": {
                    "address": { "type": "string", "maxLength": 128 },
                    "type": { "type": "string", "maxLength": 32 },
                    "label": { "type": "string", "maxLength": 32 }
                  }
                }
              },
              "avatar_b64": {
                "type": "string",
                "maxLength": 65536,
                "description": "Optional contact photo thumbnail in base64."
              },
              "starred": { "type": "boolean" }
            }
          }
        },
        "mime": {
          "type": "string",
          "maxLength": 32,
          "description": "MIME type of avatar (e.g. image/jpeg, image/png)."
        },
        "data_b64": {
          "type": "string",
          "maxLength": 65536,
          "description": "Base64 data of avatar."
        },
        "changed_at": {
          "type": "integer",
          "minimum": 0,
          "description": "Unix millisecond timestamp of change event."
        },
        "error": {
          "type": "string",
          "maxLength": 512,
          "description": "Human error message."
        },
        "error_code": {
          "type": "string",
          "maxLength": 64,
          "description": "Machine error code (permission_denied, not_found, invalid_arg, internal)."
        },
        "permission": {
          "type": "string",
          "maxLength": 32,
          "description": "Permission domain that failed (e.g. contacts)."
        }
      }
    }
  }
}
