{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Contacts",
  "description": "Contacts synchronization (capability contacts). All operations ride POST /contacts or persistent WebSocket with envelope gating protocol_v->min_peer_build->capability->token->payload. Contacts listing is cursor-paged with search query support; avatars are fetched on demand or embedded up to 64KB base64. Extended detail fields (birthday, org, nickname, postal, note, website, photo_version) are additive; decoders ignore unknown fields.",
  "type": "object",
  "additionalProperties": true,
  "required": ["protocol_v", "type", "sender", "capabilities", "payload"],
  "properties": {
    "protocol_v": { "type": "integer", "minimum": 1 },
    "type": {
      "type": "string",
      "enum": ["contacts-list-req", "contacts-list-resp", "contact-avatar-req", "contact-avatar-resp", "contacts-changed"]
    },
    "sender": {
      "type": "object",
      "additionalProperties": true,
      "required": ["platform", "app_build", "min_peer_build"],
      "properties": {
        "platform": { "type": "string" },
        "app_build": { "type": "integer", "minimum": 0 },
        "min_peer_build": { "type": "integer", "minimum": 0 },
        "app_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$",
          "description": "Human app version, e.g. 0.13.0. Display-only."
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string" }
    },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "required": ["nonce"],
      "properties": {
        "nonce": {
          "type": "string",
          "minLength": 1,
          "description": "Random per-message value the ack or response echoes."
        },
        "req_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Correlation ID for req/resp pairs."
        },
        "cursor": {
          "type": "string",
          "maxLength": 256,
          "description": "Opaque paging cursor: v2 v2.<b64name>.<rowId>; legacy b64name.rowId and bare names tolerated. Empty = first page."
        },
        "next_cursor": {
          "type": "string",
          "maxLength": 256,
          "description": "Next page cursor (empty = last page). Opaque v2 keyset; echo verbatim."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "Page limit (1..100, default 50)."
        },
        "query": {
          "type": "string",
          "maxLength": 128,
          "description": "Optional search term to filter contacts by name or phone."
        },
        "cursor_gen": {
          "type": "integer",
          "minimum": 0,
          "description": "Directory generation; mismatch means drop cache and full-resync."
        },
        "contact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Opaque phone contact ID."
        },
        "high_res": {
          "type": "boolean",
          "description": "True requests the full display photo (detail header); false/omitted = thumbnail."
        },
        "entries": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["contact_id", "display_name"],
            "properties": {
              "contact_id": { "type": "string", "minLength": 1, "maxLength": 64 },
              "display_name": { "type": "string", "maxLength": 128 },
              "phones": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "type": "object",
                  "additionalProperties": true,
                  "required": ["number"],
                  "properties": {
                    "number": { "type": "string", "maxLength": 32 },
                    "type": { "type": "string", "maxLength": 32 },
                    "label": { "type": "string", "maxLength": 32 },
                    "is_primary": { "type": "boolean" }
                  }
                }
              },
              "emails": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "type": "object",
                  "additionalProperties": true,
                  "required": ["address"],
                  "properties": {
                    "address": { "type": "string", "maxLength": 128 },
                    "type": { "type": "string", "maxLength": 32 },
                    "label": { "type": "string", "maxLength": 32 }
                  }
                }
              },
              "avatar_b64": {
                "type": "string",
                "maxLength": 65536,
                "description": "Optional contact photo thumbnail in base64."
              },
              "lookup_key": {
                "type": "string",
                "maxLength": 256,
                "description": "Stable Android LOOKUP_KEY surviving aggregation split/merge."
              },
              "last_updated_ms": {
                "type": "integer",
                "minimum": 0,
                "description": "CONTACT_LAST_UPDATED_TIMESTAMP watermark for delta sync."
              },
              "starred": { "type": "boolean" },
              "photo_version": {
                "type": "string",
                "maxLength": 128,
                "description": "Avatar version ETag for LRU eviction (photo_id:file_id:updated)."
              },
              "photo_uri": {
                "type": "string",
                "maxLength": 512,
                "description": "Optional contact photo URI string (thumb or full-size)."
              },
              "birthday_ms": {
                "type": "integer",
                "minimum": 0,
                "description": "Birthday event in unix millis (0 = unknown)."
              },
              "anniversary_ms": {
                "type": "integer",
                "minimum": 0,
                "description": "Anniversary event in unix millis (0 = unknown)."
              },
              "nickname": { "type": "string", "maxLength": 128 },
              "note": { "type": "string", "maxLength": 2048 },
              "website": { "type": "string", "maxLength": 512 },
              "organization": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "company": { "type": "string", "maxLength": 128 },
                  "title": { "type": "string", "maxLength": 128 },
                  "department": { "type": "string", "maxLength": 128 }
                }
              },
              "postal": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "formatted": { "type": "string", "maxLength": 512 },
                  "type": { "type": "string", "maxLength": 32 }
                }
              }
            }
          }
        },
        "mime": {
          "type": "string",
          "maxLength": 32,
          "description": "MIME type of avatar (e.g. image/jpeg, image/png)."
        },
        "data_b64": {
          "type": "string",
          "maxLength": 65536,
          "description": "Base64 data of avatar."
        },
        "photo_version": {
          "type": "string",
          "maxLength": 128,
          "description": "Avatar version ETag for LRU eviction."
        },
        "changed_at": {
          "type": "integer",
          "minimum": 0,
          "description": "Unix millisecond timestamp of change event."
        },
        "error": {
          "type": "string",
          "maxLength": 512,
          "description": "Human error message."
        },
        "error_code": {
          "type": "string",
          "maxLength": 64,
          "description": "Machine error code (permission_denied, not_found, invalid_arg, internal)."
        },
        "permission": {
          "type": "string",
          "maxLength": 32,
          "description": "Permission domain that failed (e.g. contacts)."
        }
      }
    }
  }
}
